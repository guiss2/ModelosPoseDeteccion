# Entorno virtual local de Python.
venv/
.venv/

# Archivos generados por Python.
__pycache__/
*.py[cod]
*$py.class

# Archivos de herramientas y configuraciones locales.
.vscode/
.idea/

# Archivos de configuración local y secretos.
.env
.env.*
!.env.example

# Archivos generados durante pruebas o ejecución.
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
